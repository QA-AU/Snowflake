CREATE OR REPLACE FILE FORMAT FF_GENERIC_CSV
TYPE = CSV
FIELD_OPTIONALLY_ENCLOSED_BY = '"'
NULL_IF = ('NULL','')
EMPTY_FIELD_AS_NULL = TRUE
ERROR_ON_COLUMN_COUNT_MISMATCH = FALSE;



CREATE OR REPLACE PROCEDURE STG.LOAD_CSV_GENERIC(
    STAGE_PATH   STRING,
    TARGET_TABLE STRING,
    DELIMITER    STRING,
    HAS_HEADER   BOOLEAN
)
RETURNS STRING
LANGUAGE SQL
AS
$$
BEGIN
    EXECUTE IMMEDIATE
        'COPY INTO ' || TARGET_TABLE || '
         FROM ' || STAGE_PATH || '
         FILE_FORMAT = (
             FORMAT_NAME = ''FF_GENERIC_CSV'',
             FIELD_DELIMITER = ''' || REPLACE(DELIMITER, '''', '''''') || '''
         )
         SKIP_HEADER = ' || IFF(HAS_HEADER, '1', '0') || '
         ON_ERROR = ''CONTINUE''';

    RETURN 'SUCCESS';
END;
$$
