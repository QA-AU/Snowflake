CREATE OR REPLACE PROCEDURE STG.LOAD_CSV_GENERIC(
    STAGE_PATH   STRING,   -- e.g. '@MY_STAGE/path/file.csv'
    TARGET_TABLE STRING,   -- e.g. 'STG.MY_TARGET'
    DELIMITER    STRING,   -- e.g. '¿'
    HAS_HEADER   BOOLEAN,  -- TRUE if first row is header
    HEADER_LIST  STRING    -- optional: 'col1,col2,col3'
)
RETURNS STRING
LANGUAGE SQL
AS
$$
DECLARE
    v_headers       STRING;
    v_cols_ddl      STRING;
    v_col_count     NUMBER;
    v_sql           STRING;
    v_delim_sql     STRING;
    v_stage_sql     STRING;
    rs              RESULTSET;
BEGIN
    -- Escape delimiter for SQL string literal
    v_delim_sql := REPLACE(DELIMITER, '''', '''''');
    v_stage_sql := STAGE_PATH;  -- keep as-is (expects @stage/path)

    /* ------------------------------------------------------------------
       1) Determine header list string (comma-separated)
       Priority:
         A) HEADER_LIST
         B) First row in file (if HAS_HEADER=TRUE)
         C) Generate COL_1..COL_N from first row column count
    ------------------------------------------------------------------ */

    IF (HEADER_LIST IS NOT NULL AND LENGTH(TRIM(HEADER_LIST)) > 0) THEN
        v_headers := REPLACE(TRIM(HEADER_LIST), ' ', '');

    ELSEIF (HAS_HEADER) THEN
        v_sql := 'SELECT $1 AS hdr
                  FROM ' || v_stage_sql || '
                  (FILE_FORMAT => (
                      TYPE => ''CSV'',
                      FIELD_DELIMITER => ''' || v_delim_sql || ''',
                      FIELD_OPTIONALLY_ENCLOSED_BY => ''"'',
                      SKIP_HEADER => 0
                  ))
                  LIMIT 1';

        rs := (EXECUTE IMMEDIATE :v_sql);
        SELECT hdr INTO :v_headers FROM TABLE(rs);

        -- Normalize (strip spaces around commas)
        v_headers := REPLACE(TRIM(v_headers), ' ', '');

    ELSE
        v_sql := 'SELECT ARRAY_SIZE(SPLIT($1, ''' || v_delim_sql || ''')) AS cnt
                  FROM ' || v_stage_sql || '
                  (FILE_FORMAT => (
                      TYPE => ''CSV'',
                      FIELD_DELIMITER => ''' || v_delim_sql || ''',
                      FIELD_OPTIONALLY_ENCLOSED_BY => ''"'',
                      SKIP_HEADER => 0
                  ))
                  LIMIT 1';

        rs := (EXECUTE IMMEDIATE :v_sql);
        SELECT cnt INTO :v_col_count FROM TABLE(rs);

        SELECT LISTAGG('COL_' || (SEQ4()+1), ',') WITHIN GROUP (ORDER BY SEQ4())
          INTO :v_headers
        FROM TABLE(GENERATOR(ROWCOUNT => v_col_count));
    END IF;

    /* ------------------------------------------------------------------
       2) Build CREATE TABLE DDL (all STRING columns)
          - Quote column names to allow special chars
          - Double-up any embedded double quotes
    ------------------------------------------------------------------ */

    SELECT LISTAGG(
               '"' || REPLACE(TRIM(value), '"', '""') || '" STRING',
               ','
           ) WITHIN GROUP (ORDER BY seq)
      INTO :v_cols_ddl
    FROM TABLE(SPLIT_TO_TABLE(v_headers, ','));

    /* ------------------------------------------------------------------
       3) Drop + Create target table
    ------------------------------------------------------------------ */

    EXECUTE IMMEDIATE 'DROP TABLE IF EXISTS ' || TARGET_TABLE;
    EXECUTE IMMEDIATE 'CREATE TABLE ' || TARGET_TABLE || ' (' || v_cols_ddl || ')';

    /* ------------------------------------------------------------------
       4) COPY INTO target
          - Uses delimiter (including legacy '¿')
          - Handles quoted values
          - Normalizes NULLs/empty strings
          - Skips header row if HAS_HEADER=TRUE
    ------------------------------------------------------------------ */

    v_sql := 'COPY INTO ' || TARGET_TABLE || '
              FROM ' || v_stage_sql || '
              FILE_FORMAT = (
                  TYPE = ''CSV'',
                  FIELD_DELIMITER = ''' || v_delim_sql || ''',
                  FIELD_OPTIONALLY_ENCLOSED_BY = ''"'',
                  SKIP_HEADER = ' || IFF(HAS_HEADER, '1', '0') || ',
                  NULL_IF = (''NULL'',''''),
                  EMPTY_FIELD_AS_NULL = TRUE,
                  ERROR_ON_COLUMN_COUNT_MISMATCH = FALSE
              )
              ON_ERROR = ''CONTINUE''';

    EXECUTE IMMEDIATE v_sql;

    RETURN 'SUCCESS: created ' || TARGET_TABLE || ' with columns [' || v_headers || '] and loaded from ' || STAGE_PATH;

END;
$$;



CALL STG.LOAD_CSV_GENERIC(
  '@MY_STAGE/legacy.csv',
  'STG.FIN_DATA',
  '¿',
  TRUE,
  NULL
);


